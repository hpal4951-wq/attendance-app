{
  "expo": {
    "name": "HostelConnect",
    "slug": "hostel-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HostelConnect uses your location to automatically verify your presence at the hostel."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hostelconnect.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563eb"
      },
      "package": "com.hostelconnect.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
