{
  "expo": {
    "name": "HostelConnect",
    "slug": "hostel-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HostelConnect uses your location to automatically verify your presence at the hostel."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2563eb",
          "defaultChannel": "general",
          "channels": [
            { "id": "attendance", "name": "Attendance", "importance": 4 },
            { "id": "mess", "name": "Mess Menu", "importance": 3 },
            { "id": "polls", "name": "Polls", "importance": 3 },
            { "id": "general", "name": "General", "importance": 3 }
          ]
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hostelconnect.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563eb"
      },
      "package": "com.hostelconnect.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
