# Server
PORT=5000

# MongoDB connection string (never commit the real one)
MONGO_URI=mongodb://127.0.0.1:27017/attendance_app

# JWT signing secret — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# Attendance warning threshold (percent) for low-attendance alerts
ATTENDANCE_WARNING_THRESHOLD=75

# Application timezone (attendance dates and window checks use this,
# never the device clock). Intended for India.
APP_TIMEZONE=Asia/Kolkata

# Daily attendance verification window (HH:mm, 24-hour, in APP_TIMEZONE).
# 00:00–23:59 keeps the window always open; narrow it for real deployments.
ATTENDANCE_WINDOW_START=00:00
ATTENDANCE_WINDOW_END=23:59

# Maximum acceptable GPS accuracy (meters) for automatic attendance.
# If a device fix reports accuracy worse than this, attendance is NOT marked.
MAX_ACCEPTABLE_ACCURACY=100

# Fallback attendance radius when a hostel has none configured (meters).
ATTENDANCE_DEFAULT_RADIUS=120

# Optional safety buffer in meters (informational only — decision rule stays
# distance <= radius => PRESENT, distance > radius => OUTSIDE).
ATTENDANCE_BUFFER_METERS=0

# Rate limiting for POST /api/attendance/verify-location
ATTENDANCE_RATE_LIMIT_WINDOW_MS=60000
ATTENDANCE_RATE_LIMIT_MAX=30

# Firebase Cloud Messaging (optional — for push notifications)
# FCM_SERVER_KEY=
# FCM_PROJECT_ID=
